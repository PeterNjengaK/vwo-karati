HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/church.sqlite
# Set production and an HTTPS PUBLIC_ORIGIN on your hosted server.
NODE_ENV=development
# Enable only when a reverse proxy on this machine overwrites X-Real-IP.
TRUST_LOCAL_PROXY=false
# disabled, sandbox, or production. No simulated payments are recorded as real gifts.
MPESA_MODE=disabled
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# CustomerPayBillOnline or CustomerBuyGoodsOnline (confirm with Safaricom)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Random secret of at least 32 characters. Callback URL is generated from PUBLIC_ORIGIN.
MPESA_CALLBACK_SECRET=
